# The Blush Studio — environment template. Copy to backend/.env and frontend/.env (VITE_*) — never commit real values.
# Backend
DATABASE_URL=postgresql+asyncpg://sundara:sundara@localhost:5432/sundara
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set on a deploy to auto-promote this login to admin at startup:
# ADMIN_EMAIL=owner@example.com
ENV=development
# Frontend (prefix VITE_)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
